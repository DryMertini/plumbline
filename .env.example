# Everything is optional - with nothing set, plumbline runs fully offline.

# Provider chain, in order. The offline extractive reader is always appended as the last
# fallback. Options: extractive | anthropic | openai
PLUMBLINE_PROVIDERS=extractive

# --- Claude (PLUMBLINE_PROVIDERS=anthropic) ---
# ANTHROPIC_API_KEY=
# PLUMBLINE_ANTHROPIC_MODEL=claude-opus-5-5
# PLUMBLINE_ANTHROPIC_EFFORT=medium
# PLUMBLINE_ANTHROPIC_SERVER_FALLBACK=1

# --- Any OpenAI-compatible endpoint, e.g. a local Ollama (PLUMBLINE_PROVIDERS=openai) ---
# PLUMBLINE_OPENAI_BASE_URL=http://localhost:11434/v1
# PLUMBLINE_OPENAI_MODEL=llama3.1
# PLUMBLINE_OPENAI_API_KEY=

# --- Resilience budget ---
# PLUMBLINE_DEADLINE_S=20
# PLUMBLINE_ATTEMPT_TIMEOUT_S=8
# PLUMBLINE_MAX_ATTEMPTS=3
# PLUMBLINE_MAX_REPAIRS=1

# PLUMBLINE_DATA_DIR=data
